{
  "name": "vidmo-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Miniature cooking film studio: turns an audience + dish choice into a locked storyboard, then generates stage images and image-to-video clips in your own Google Flow session. Core app is zero-dependency; Flow browser automation uses optional playwright-core.",
  "license": "MIT",
  "author": "Faysal Matheen <faysalmatheen@gmail.com> (https://github.com/F4Y547)",
  "homepage": "https://github.com/F4Y547/vidmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/F4Y547/vidmo.git"
  },
  "bugs": {
    "url": "https://github.com/F4Y547/vidmo/issues"
  },
  "keywords": [
    "miniature-cooking",
    "tiny-food",
    "video-generation",
    "prompt-engineering",
    "asmr",
    "shorts",
    "reels",
    "veo",
    "kling",
    "runway",
    "sora",
    "google-flow",
    "nano-banana",
    "image-to-video",
    "food-photography"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:flow": "node --test test/flow.mock.test.js",
    "smoke": "node scripts/smoke.mjs",
    "flow:discover": "node scripts/flow-discover.mjs"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  }
}
