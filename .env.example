# VidMo Studio — environment configuration
# Copy this file to `.env` and adjust as needed. Every variable is optional —
# the studio runs fully offline with the deterministic local prompt engine.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
# Port and host for the local studio server.
PORT=4173
HOST=127.0.0.1

# Where film projects are persisted (JSON store). Defaults to ./data.
# VIDMO_DATA_DIR=C:\path\to\custom\data

# ----------------------------------------------------------------------------
# AI recipe planner (optional)
# ----------------------------------------------------------------------------
# When configured, custom dishes can be planned by an OpenAI-compatible model.
# The model ONLY proposes the recipe stages; the locked image/motion/audio
# prompt engine always writes the final prompts. Without a key the local
# deterministic planner is used.
# OPENAI_API_KEY=sk-...
# VIDMO_AI_API_KEY=sk-...            # alternative name for the same key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini

# ----------------------------------------------------------------------------
# Render bridge (optional)
# ----------------------------------------------------------------------------
# Point this at any renderer that accepts a JSON job manifest (your own
# service, a queue consumer, an automation such as n8n/Make). Without it the
# studio stays in "pack export mode": download the ZIP/handoff artifacts and
# submit them to Veo 3.1, Kling 2.5, Runway Gen-4 or Sora 2 manually.
# VIDMO_RENDER_WEBHOOK=https://your-renderer.example/api/jobs
# VIDMO_RENDER_WEBHOOK_TOKEN=optional-bearer-token

# Public URL of this studio, used to build the callback URL sent to the
# renderer. Required for render status callbacks to come back automatically.
# VIDMO_PUBLIC_URL=https://your-tunnel.example

# When set, renderer callbacks must send this value in the X-VidMo-Secret
# header before stage statuses are updated.
# VIDMO_RENDER_CALLBACK_SECRET=optional-callback-secret

# ----------------------------------------------------------------------------
# Google Flow generation (optional)
# ----------------------------------------------------------------------------
# VidMo can generate stage images and image-to-video clips inside YOUR OWN
# signed-in Google Flow session (https://labs.google/fx/tools/flow). Flow has
# no public API, so VidMo drives a real visible Chrome/Edge window with its own
# local profile. It never asks for or stores your Google password, cookies or
# tokens: you sign in yourself in that window, once.
#
# Requires the optional driver:  npm install playwright-core
#
# "browser" (default) automates your signed-in session. "stub" creates
# placeholder media locally — great for testing the pipeline with no credits.
# VIDMO_FLOW_MODE=browser

# Explicit browser executable. By default VidMo finds Chrome or Edge.
# VIDMO_FLOW_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Hide the Flow window. Keep it visible for the first sign-in; headless mode
# can still attach to the same persisted profile afterwards.
# VIDMO_FLOW_HEADLESS=0

# Where the local Flow browser profile, downloads and diagnostics live.
# VIDMO_FLOW_PROFILE_DIR=C:\path\to\flow-profile
# VIDMO_FLOW_DIR=C:\path\to\flow-data

# Preferred Flow models when the picker is available (optional).
# VIDMO_FLOW_IMAGE_MODEL=Nano Banana Pro
# VIDMO_FLOW_VIDEO_MODEL=Veo 3.1

# Generation timeouts in milliseconds (images default ~8 min, clips ~25 min).
# VIDMO_FLOW_IMAGE_TIMEOUT_MS=480000
# VIDMO_FLOW_VIDEO_TIMEOUT_MS=1500000

# How long to wait for you to finish Google sign-in / manual Flow steps.
# VIDMO_FLOW_LOGIN_TIMEOUT_MS=600000
# VIDMO_FLOW_ATTENTION_TIMEOUT_MS=1800000

# Upload limit for bringing manual Flow downloads back into VidMo (default 250 MB).
# VIDMO_MAX_UPLOAD_BYTES=262144000
